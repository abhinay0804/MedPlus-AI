# ──────────────────────────────────────
# Database
# ──────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./healthcare.db
# For PostgreSQL in Docker / Prod: postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_db
SQLITE_FALLBACK=1

# ──────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────
# LLM — Google Gemini
# ──────────────────────────────────────
GOOGLE_GENAI_API_KEY=your-gemini-api-key-here

# ──────────────────────────────────────
# Email — Gmail SMTP
# ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=HealthCare Appointments
EMAIL_FROM_ADDRESS=noreply@healthcare.com

# ──────────────────────────────────────
# Google Calendar OAuth 2.0
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# ──────────────────────────────────────
# Redis (Celery Broker + Cache)
# ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
